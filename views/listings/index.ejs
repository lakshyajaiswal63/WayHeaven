<% layout("layouts/boilerplate") %>

<!-- <h3>All Listings</h3> -->

<!-- <form method="GET" action="/listings/new">
  <button type="submit">Create New Listing</button>
</form> -->

<div class="filters">
  <a href="/listings?category=Rooms" class="filter text-decoration-none text-dark">
    <div>
      <i class="fa-solid fa-bed"></i>
    </div>
    <p>Rooms</p>
  </a>

  <a href="/listings?category=Mountains" class="filter text-decoration-none text-dark">
    <div>
      <i class="fa-solid fa-mountain-city"></i>
    </div>
    <p>Mountains</p>
  </a>

  <a href="/listings?category=Beaches" class="filter text-decoration-none text-dark">
    <div>
      <i class="fa-solid fa-umbrella-beach"></i>
    </div>
    <p>Beaches</p>
  </a>

  <a href="/listings?category=Tiny%20Homes" class="filter text-decoration-none text-dark">
    <div>
      <i class="fa-solid fa-house-chimney-window"></i>
    </div>
    <p>Tiny Homes</p>
  </a>

  <a href="/listings?category=Amazing%20Pools" class="filter text-decoration-none text-dark">
    <div>
      <i class="fa-solid fa-person-swimming"></i>
    </div>
    <p>Amazing Pools</p>
  </a>

  <a href="/listings?category=Castles" class="filter text-decoration-none text-dark">
    <div>
      <i class="fa-brands fa-fort-awesome"></i>
    </div>
    <p>Castles</p>
  </a>

  <a href="/listings?category=Iconic%20Cities" class="filter text-decoration-none text-dark">
    <div>
      <i class="fa-solid fa-city"></i>
    </div>
    <p>Iconic Cities</p>
  </a>

  <a href="/listings?category=Camping" class="filter text-decoration-none text-dark">
    <div>
      <i class="fa-solid fa-campground"></i>
    </div>
    <p>Camping</p>
  </a>

  <a href="/listings?category=Farms" class="filter text-decoration-none text-dark">
    <div>
      <i class="fa-solid fa-tractor"></i>
    </div>
    <p>Farms</p>
  </a>

  <a href="/listings?category=Domes" class="filter text-decoration-none text-dark">
    <div>
      <i class="fa-solid fa-landmark-dome"></i>
    </div>
    <p>Domes</p>
  </a>

  <a href="/listings?category=Boats" class="filter text-decoration-none text-dark">
    <div>
      <i class="fa-solid fa-ship"></i>
    </div>
    <p>Boats</p>
  </a>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault" />
      <label class="form-check-label" for="flexSwitchCheckDefault">Display total after Taxes</label>
    </div>
  </div>
</div>

<% if(searchTerm || selectedCategory) { %>
  <div class="mt-3 mb-3">
    <% if(searchTerm) { %>
      <span>Search results for: <b><%= searchTerm %></b></span>
    <% } %>

    <% if(selectedCategory) { %>
      <span class="ms-3">Category: <b><%= selectedCategory %></b></span>
    <% } %>

    <a href="/listings" class="ms-3">Clear filters</a>
  </div>
<% } %>

<div class="row row-cols-1 row-cols-lg-3 row-cols-md-2 mt-3">
  <% if(alllistings.length === 0) { %>
    <div class="col-12">
      <h4>No listings found.</h4>
    </div>
  <% } %>

  <% for(let listing of alllistings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col listing-card">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="listing_image"
          style="height: 20rem;"
        />
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b>
            <br />
            <span class="listing-price" data-price="<%= listing.price %>">
              &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
            </span>
            <i class="tax-info">&nbsp;+18% GST</i>
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>

<script>
  let taxSwitch = document.getElementById("flexSwitchCheckDefault");

  taxSwitch.addEventListener("click", () => {
    let priceElements = document.getElementsByClassName("listing-price");
    let taxInfo = document.getElementsByClassName("tax-info");

    for (let i = 0; i < priceElements.length; i++) {
      let price = Number(priceElements[i].dataset.price);

      if (taxSwitch.checked) {
        let total = Math.round(price * 1.18);
        priceElements[i].innerHTML = `&#8377;${total.toLocaleString("en-IN")}/night`;
        taxInfo[i].innerHTML = "&nbsp;(incl. 18% GST)";
        taxInfo[i].style.display = "inline";
      } else {
        priceElements[i].innerHTML = `&#8377;${price.toLocaleString("en-IN")}/night`;
        taxInfo[i].innerHTML = "&nbsp;+18% GST";
        taxInfo[i].style.display = "inline";
      }
    }
  });
</script>